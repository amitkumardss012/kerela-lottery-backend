generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model winner {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  email         String
  state         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ticket_number String
  prize_amount  String
  winner_rank   String?
  lottery_id    Int
  claimed       Boolean  @default(false)
  lottery       lottery  @relation(fields: [lottery_id], references: [id])

  @@index([ticket_number])
  @@index([phone])
  @@index([email])
  @@index([lottery_id], map: "winner_lottery_id_fkey")
}

model admin {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique(map: "Admin_email_key")
  password  String
  role      admin_role @default(sub_admin)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  blog_posts blog_post[]

  @@index([email], map: "Admin_email_idx")
}

model buyer {
  id                 Int                      @id @default(autoincrement())
  name               String
  email              String
  phone              String
  state              String
  lottery_id         Int?
  ticket_package_id  Int?
  transaction_id     String?                  @unique(map: "Buyer_transaction_id_key")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  transaction_status buyer_transaction_status @default(not_verified)
  is_read            Boolean                  @default(false)
  lottery            lottery?                 @relation(fields: [lottery_id], references: [id], map: "Buyer_lottery_id_fkey")
  ticketpackage      ticketpackage?           @relation(fields: [ticket_package_id], references: [id], map: "Buyer_ticket_package_id_fkey")
  ticket             ticket[]

  @@index([email], map: "Buyer_email_idx")
  @@index([lottery_id], map: "Buyer_lottery_id_fkey")
  @@index([phone], map: "Buyer_phone_idx")
  @@index([ticket_package_id], map: "Buyer_ticket_package_id_fkey")
}

model enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  state     String?
  subject   String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt], map: "Enquiry_createdAt_idx")
  @@index([email], map: "Enquiry_email_idx")
}

model lottery {
  id            Int             @id @default(autoincrement())
  name          String
  result_time   String
  is_active     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  result_date   String
  image         Json?
  buyer         buyer[]
  ticket        ticket[]
  winner        winner[]
  ticketpackage ticketpackage[]

  @@index([result_time], map: "Lottery_result_time_idx")
}

model ticket {
  id                Int           @id @default(autoincrement())
  lottery_id        Int
  ticket_package_id Int
  ticket_number     String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transaction_id    String
  buyer_id          Int
  buyer             buyer         @relation(fields: [buyer_id], references: [id], map: "Ticket_buyer_id_fkey")
  lottery           lottery       @relation(fields: [lottery_id], references: [id], map: "Ticket_lottery_id_fkey")
  ticketpackage     ticketpackage @relation(fields: [ticket_package_id], references: [id], map: "Ticket_ticket_package_id_fkey")

  @@unique([lottery_id, ticket_number, transaction_id], map: "Ticket_lottery_id_ticket_number_transaction_id_key")
  @@index([buyer_id], map: "Ticket_buyer_id_fkey")
  @@index([lottery_id], map: "Ticket_lottery_id_idx")
  @@index([ticket_package_id], map: "Ticket_ticket_package_id_fkey")
}

enum package_badge {
  POPULAR          // Badge highlighting the most popular package among buyers
  BEST_VALUE       // Badge for packages with the best value/discount ratio
  RECOMMENDED      // Badge for officially recommended package
  HOT_DEAL         // Badge for high-converting deal packages
  EXCLUSIVE        // Badge for premium exclusive ticket packages
  LIMITED_OFFER    // Badge for time-sensitive flash offers
}

model ticketpackage {
  id                   Int            @id @default(autoincrement())
  name                 String         // Package name (e.g. "Super Saver Pack", "Mega Combo", "Gold Bundle")
  description          String?        @db.Text // Rich description (e.g. "Buy 10 Tickets & Get 2 Bonus Tickets Free + WhatsApp Delivery")
  badge                package_badge? // Optional badge tag: POPULAR, BEST_VALUE, RECOMMENDED, HOT_DEAL, EXCLUSIVE, LIMITED_OFFER
  image                Json?          // Optional Cloudinary image asset object { public_id, secure_url } or URL string

  // Ticket Counts
  number_of_tickets    Int            // Total tickets delivered to buyer (e.g. 12)
  paid_tickets         Int            // Number of paid tickets (e.g. 10)
  free_tickets         Int?           @default(0) // Number of free bonus tickets included (e.g. 2)

  // Pricing & Discounts
  price                Float          // Selling price in INR (e.g. 400.0)
  original_price       Float?         // Original price before discount for strikethrough UI (e.g. 500.0)
  savings_text         String?        // Savings text badge (e.g. "Save ₹100 Instant", "20% OFF")

  // Value Hooks & Perks
  odds_multiplier_text String?        // Winning odds boost text (e.g. "10x Higher Chance of Winning", "5x Odds Boost")
  bonus_perks          Json?          // Array of bullet perks (e.g. ["Instant PDF Receipt", "Auto Ticket Matching", "Priority Entry"])
  valid_until          DateTime?      // Optional expiry DateTime for limited-time flash offer countdowns (e.g. 2026-12-31T23:59:59Z)

  is_active            Boolean        @default(true) // Package visibility status (true = active on checkout, false = hidden)

  // Relation to Lottery
  lottery_id           Int?           // Foreign key ID of specific lottery draw (e.g. 1), or null for global package across all lotteries
  lottery              lottery?       @relation(fields: [lottery_id], references: [id])

  createdAt            DateTime       @default(now()) // Timestamp when ticket package was created
  updatedAt            DateTime       @updatedAt // Timestamp when ticket package was last updated

  buyer                buyer[]        // Relational list of buyers who purchased this ticket package
  ticket               ticket[]       // Relational list of individual tickets generated under this package

  @@index([lottery_id])
  @@index([is_active])
}

enum admin_role {
  admin
  sub_admin
}

enum buyer_transaction_status {
  not_verified
  verified
  failed
  success
  refunded
  rejected
}

model QRCode {
  id        Int      @id @default(autoincrement())
  phone     String?
  image     Json?
  upi       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebConfig {
  id             Int     @id @default(autoincrement())
  whatsAppNumber String?
  phoneNumber    String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model blog_category {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  slug      String      @unique
  posts     blog_post[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([slug])
}

model blog_tag {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  slug      String      @unique
  posts     blog_post[] @relation("BlogPostTags")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([slug])
}

model blog_post {
  id             Int     @id @default(autoincrement())
  title          String
  slug           String  @unique
  content        String  @db.LongText
  summary        String? @db.Text
  featured_image Json?

  // SEO fields
  meta_title       String?
  meta_description String? @db.Text
  meta_keywords    String? @db.Text

  is_published Boolean   @default(false)
  published_at DateTime?

  views Int @default(0)

  author_id Int
  author    admin @relation(fields: [author_id], references: [id])

  category_id Int?
  category    blog_category? @relation(fields: [category_id], references: [id])

  tags blog_tag[] @relation("BlogPostTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([author_id])
  @@index([category_id])
  @@index([is_published])
  @@index([createdAt])
}
